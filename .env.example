# הגדרות Firebase.
#
# הערכים האלה כבר מוטמעים כברירת מחדל ב-src/lib/firebase.ts, ולכן הקובץ הזה
# נדרש רק אם רוצים להצביע על פרויקט Firebase אחר (למשל סביבת בדיקות).
#
# מפתח ה-Web של Firebase אינו סוד — הוא מגיע ללקוח בכל מקרה. ההגנה בפועל
# מגיעה מהגבלת הדומיינים המורשים בקונסולת Firebase ומכללי האבטחה.
#
# לשימוש: העתיקו לקובץ בשם .env.local ומלאו.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
