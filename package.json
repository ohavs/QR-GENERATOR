{
  "name": "qr-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "מחולל קודי QR מעוצבים - QR Studio",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "python3 scripts/generate-icons.py",
    "test:scan": "node scripts/scan-test.mjs",
    "test:export": "node scripts/export-test.mjs",
    "deploy": "npm run build && firebase deploy --only hosting",
    "test:logo": "node scripts/logo-bg-test.mjs",
    "test:content": "node scripts/content-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:palette": "node scripts/palette-test.mjs",
    "test:batch": "node scripts/batch-test.mjs",
    "test:batch-scan": "node scripts/batch-scan-test.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "framer-motion": "^12.43.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.28.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
